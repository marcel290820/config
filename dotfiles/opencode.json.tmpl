{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nvidia": {
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "${NVIDIA_API_KEY}"
      }
    }
  },
  "plugin": [],
  "model": "nvidia/z-ai/glm-5.1",
  "small_model": "nvidia/z-ai/glm-5.1",
  "agent": {
    "plan": {
      "model": "nvidia/z-ai/glm-5.1",
      "temperature": 0.3,
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "build": {
      "model": "nvidia/z-ai/glm-5.1",
      "temperature": 0.3,
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "coder": {
      "model": "nvidia/minimaxai/minimax-m2.7",
      "temperature": 0.2,
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "explore": {
      "model": "nvidia/z-ai/glm-5.1",
      "temperature": 0.2,
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "researcher": {
      "model": "nvidia/z-ai/glm-5.1",
      "temperature": 0.4,
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "scribe": {
      "model": "nvidia/minimaxai/minimax-m2.7",
      "temperature": 1,
      "reasoningEffort": "low",
      "textVerbosity": "high"
    },
    "reviewer": {
      "model": "nvidia/minimaxai/minimax-m2.7",
      "temperature": 0.1,
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  }
}
